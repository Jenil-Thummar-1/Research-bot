# Groq Cloud API key - Recommended default provider with 14,400 free req/day (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key (https://aistudio.google.com)
# Supports single key or comma-separated keys for pool rotation: key1,key2,key3
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API key for web search grounding (https://tavily.com)
# If omitted, DuckDuckGo keyless search will be used automatically
TAVILY_API_KEY=your_tavily_api_key_here
